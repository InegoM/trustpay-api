{
  "name": "trustpay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/assert-test-database.mjs && vitest run src/postgres-app.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "security:password-benchmark": "tsx scripts/benchmark-password.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:up": "docker compose up -d postgres localstack clamav",
    "db:down": "docker compose down",
    "db:test:up": "docker compose up -d postgres-test",
    "db:test:down": "docker compose stop postgres-test",
    "db:test:deploy": "prisma migrate deploy --config prisma-test.config.ts",
    "db:test:seed": "prisma db seed --config prisma-test.config.ts",
    "storage:cleanup": "tsx scripts/cleanup-evidence.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.0.0",
    "fastify": "^5.0.0",
    "file-type": "^22.0.2",
    "pg": "8.23.0",
    "sharp": "^0.35.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.9.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
